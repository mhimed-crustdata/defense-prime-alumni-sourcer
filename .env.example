# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# The role you are hiring for, in plain words (used for scoring)
ROLE_BRIEF=embedded software engineer C++ real-time systems
MIN_SCORE=50

# Optional: Slack incoming webhook (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude scoring (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
